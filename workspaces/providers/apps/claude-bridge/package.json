{
  "name": "studio-claude-bridge",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --config vitest.config.mjs",
    "check:focused": "pnpm run typecheck && vitest run --config vitest.config.mjs",
    "test:fast": "pnpm run typecheck && vitest run --config vitest.fast.config.mjs --project fast",
    "typecheck": "tsc --project tsconfig.json --incremental --tsBuildInfoFile \"${STUDIO_TSC_CACHE:-${TMPDIR:-/tmp}}/codex-studio-claude-usage.tsbuildinfo\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.308",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "vitest": "5.0.5"
  },
  "codexStudioChecks": {
    "test": "test",
    "check": [
      "check:focused"
    ]
  }
}
