<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The iOS shell loads the user's HTTPS Studio server. Plain HTTP is
       allowed only on loopback, for the simulator preview. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
  <!-- The start page lists Studio servers on the local network. The service
       type is owned by runtime-schema/src/bonjour_protocol.rs. -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>Find the Studio server on this network so that you do not need to type its address.</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_layr-studio._tcp</string>
  </array>
  <key>UIStatusBarHidden</key>
  <false/>
</dict>
</plist>
