{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "paths": { "/src/*": ["./src/*"] },
    // TypeScript migration: remove after ts-web-strict-sync-servers and ts-web-strict-components land.
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "src",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.fast.config.ts",
    "playwright.config.ts",
    "vitest.unit.config.ts"
  ]
}
