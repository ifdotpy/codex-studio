{
  "$defs": {
    "AnalyticsNativeItem": {
      "additionalProperties": true,
      "properties": {
        "durationMs": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Durationms"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Id"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tool"
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Type"
        }
      },
      "title": "AnalyticsNativeItem",
      "type": "object"
    },
    "AnalyticsTokenEnvelope": {
      "additionalProperties": true,
      "properties": {
        "last": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalyticsTokens"
            },
            {
              "type": "null"
            }
          ]
        },
        "modelContextWindow": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Modelcontextwindow"
        },
        "total": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalyticsTokens"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "title": "AnalyticsTokenEnvelope",
      "type": "object"
    },
    "AnalyticsTokens": {
      "additionalProperties": true,
      "properties": {
        "cacheWriteInputTokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cachewriteinputtokens"
        },
        "cachedInputTokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cachedinputtokens"
        },
        "inputTokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Inputtokens"
        },
        "outputTokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Outputtokens"
        },
        "reasoningOutputTokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reasoningoutputtokens"
        },
        "totalTokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Totaltokens"
        }
      },
      "title": "AnalyticsTokens",
      "type": "object"
    },
    "CumulativeModelUsage": {
      "additionalProperties": false,
      "description": "One model's cumulative contribution to a Claude query.",
      "properties": {
        "model": {
          "description": "Provider model identifier; dimensionless.",
          "type": "string"
        },
        "providerCostUsd": {
          "description": "Provider's informational cost estimate; USD.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "tokens": {
          "$ref": "#/$defs/UsageTokens",
          "description": "Disjoint cumulative token counts; tokens."
        }
      },
      "required": [
        "model",
        "tokens"
      ],
      "type": "object"
    },
    "UsageEvidence": {
      "description": "Provenance of a final response; legacy observations may be provisional.",
      "enum": [
        "live",
        "recovered",
        "legacy"
      ],
      "type": "string"
    },
    "UsageGapReason": {
      "description": "Why final response accounting is unavailable.",
      "oneOf": [
        {
          "enum": [
            "streamInterrupted",
            "queryClosed"
          ],
          "type": "string"
        },
        {
          "const": "unconfirmedStop",
          "description": "Stream stopped without a provider delta confirming completion.",
          "type": "string"
        },
        {
          "const": "noStream",
          "description": "Assistant message arrived without any stream for its response identity.",
          "type": "string"
        }
      ]
    },
    "UsageIdentity": {
      "description": "Logical owner of usage, independent of capture time, account, turn and provenance.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A provider response (including a gap awaiting its final usage).",
          "properties": {
            "agent": {
              "type": "string"
            },
            "kind": {
              "const": "response",
              "type": "string"
            },
            "responseId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "agent",
            "responseId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A running counter, whose individual observations have separate receipts.",
          "properties": {
            "agent": {
              "type": "string"
            },
            "kind": {
              "const": "cumulative",
              "type": "string"
            },
            "scope": {
              "$ref": "#/$defs/UsageScope"
            },
            "threadId": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "agent",
            "threadId",
            "scope"
          ],
          "type": "object"
        }
      ]
    },
    "UsageLedgerRow": {
      "description": "Durable typed receipt. Analytics stores these fields alongside presentation metadata;\nbudget stores the same value alongside its accounting placement.",
      "properties": {
        "receiptKey": {
          "description": "First-capture deduplication key; retained across restore and re-import.",
          "type": [
            "string",
            "null"
          ]
        },
        "studioUsage": {
          "$ref": "#/$defs/UsageObservation",
          "description": "Provider-neutral evidence; token fields have units of tokens."
        },
        "usageIdentity": {
          "$ref": "#/$defs/UsageIdentity",
          "description": "Immutable logical usage identity; dimensionless."
        }
      },
      "required": [
        "usageIdentity",
        "receiptKey",
        "studioUsage"
      ],
      "type": "object"
    },
    "UsageObservation": {
      "description": "Accounting evidence, preserving response identity and cumulative counter scope.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Final usage for one response, keyed by agent and response ID.",
          "properties": {
            "evidence": {
              "$ref": "#/$defs/UsageEvidence",
              "description": "How the final usage was collected."
            },
            "kind": {
              "const": "response",
              "type": "string"
            },
            "model": {
              "description": "Provider model identifier; dimensionless.",
              "type": "string"
            },
            "modelContextWindow": {
              "description": "Model context capacity; tokens.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "parentToolUseId": {
              "description": "Parent tool identifier; absent means main loop.",
              "type": [
                "string",
                "null"
              ]
            },
            "responseId": {
              "description": "Native response identifier; dimensionless.",
              "type": "string"
            },
            "tokens": {
              "$ref": "#/$defs/UsageTokens",
              "description": "Final disjoint token counts; tokens."
            },
            "turnId": {
              "description": "Native turn identifier; dimensionless.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "responseId",
            "model",
            "tokens",
            "evidence"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Running provider counter; never added to response records.",
          "properties": {
            "kind": {
              "const": "cumulative",
              "type": "string"
            },
            "last": {
              "anyOf": [
                {
                  "$ref": "#/$defs/UsageTokens"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Most recent response without an identity; tokens."
            },
            "modelContextWindow": {
              "description": "Model context capacity; tokens.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "models": {
              "description": "Per-model running counters and informational provider costs.",
              "items": {
                "$ref": "#/$defs/CumulativeModelUsage"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "scope": {
              "$ref": "#/$defs/UsageScope",
              "description": "Counter's reset and accumulation domain."
            },
            "total": {
              "$ref": "#/$defs/UsageTokens",
              "description": "Running disjoint category counts; tokens."
            },
            "turnId": {
              "description": "Native turn identifier; dimensionless.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "scope",
            "total"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A response with no final usage; unknown rather than zero tokens.",
          "properties": {
            "kind": {
              "const": "gap",
              "type": "string"
            },
            "model": {
              "description": "Provider model identifier, when known.",
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "$ref": "#/$defs/UsageGapReason",
              "description": "Final-usage loss reason."
            },
            "responseId": {
              "description": "Native response identifier; dimensionless.",
              "type": "string"
            },
            "turnId": {
              "description": "Native turn identifier; dimensionless.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "responseId",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "UsageReplayConflict": {
      "additionalProperties": false,
      "description": "A rejected replay, preserving both totals without inventing missing legacy categories.",
      "properties": {
        "identity": {
          "$ref": "#/$defs/UsageIdentity"
        },
        "incomingTokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsageTokens"
            },
            {
              "type": "null"
            }
          ]
        },
        "incomingTotalTokens": {
          "description": "Rejected billable total; tokens.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "retainedTokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsageTokens"
            },
            {
              "type": "null"
            }
          ]
        },
        "retainedTotalTokens": {
          "description": "Retained billable total; tokens.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "identity",
        "retainedTotalTokens",
        "incomingTotalTokens"
      ],
      "type": "object"
    },
    "UsageScope": {
      "description": "Counter ownership: a native Codex thread or one Claude SDK query.",
      "enum": [
        "codexThread",
        "claudeQuery"
      ],
      "type": "string"
    },
    "UsageTokens": {
      "additionalProperties": false,
      "description": "Disjoint billable token categories; reasoning is already included in output.",
      "properties": {
        "cacheReadInput": {
          "description": "Input served from the prompt cache; tokens.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "cacheWriteInput": {
          "description": "Input written to the prompt cache; tokens.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "cacheWriteInput1h": {
          "description": "Subset of cache writes with a one-hour lifetime; tokens, absent for legacy pricing.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "output": {
          "description": "All generated output, including reasoning; tokens.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "reasoningOutput": {
          "description": "Known reasoning subset of output; tokens, absent when unknown.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "uncachedInput": {
          "description": "Base-rate input, excluding cache reads and writes; tokens.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "uncachedInput",
        "cacheReadInput",
        "cacheWriteInput",
        "output"
      ],
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "completedAt": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Completedat"
    },
    "item": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnalyticsNativeItem"
        },
        {
          "type": "null"
        }
      ]
    },
    "itemId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Itemid"
    },
    "rawTokenUsageRecord": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Rawtokenusagerecord"
    },
    "requestUsage": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnalyticsTokens"
        },
        {
          "type": "null"
        }
      ]
    },
    "responseId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Responseid"
    },
    "startedAt": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Startedat"
    },
    "studioUsage": {
      "$ref": "#/$defs/UsageObservation"
    },
    "threadId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Threadid"
    },
    "tokenUsage": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnalyticsTokenEnvelope"
        },
        {
          "type": "null"
        }
      ]
    },
    "turn": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Turn"
    },
    "turnId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Turnid"
    }
  },
  "title": "AnalyticsNotice",
  "type": "object"
}
