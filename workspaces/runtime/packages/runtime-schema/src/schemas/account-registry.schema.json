    "AccountStartThrottle": {
      "additionalProperties": false,
      "description": "Turn start throttle of one account, the same for every provider.\n\nStudio starts at most `burst` turns at once, then waits `pauseSeconds` after the\nstart that ends a burst (`burst` starts made, or the last free running slot taken),\nand keeps at most `maxRunningTurns` turns running. A turn over a limit waits and\nstarts later. Studio limits turn starts only, not the provider's own requests\ninside a turn. Bounds: codex_shared_values.ACCOUNT_START_* and ACCOUNT_RUNNING_TURNS_*.",
      "properties": {
        "burst": {
          "description": "Turn starts per burst.",
          "maximum": 512,
          "minimum": 1,
          "title": "Burst",
          "type": "integer",
          "x-safe-integer": "unsigned"
        },
        "maxRunningTurns": {
          "description": "Turns that may run at once on this account.",
          "maximum": 512,
          "minimum": 1,
          "title": "Maxrunningturns",
          "type": "integer",
          "x-safe-integer": "unsigned"
        },
        "pauseSeconds": {
          "description": "Seconds after the start that ends a burst before the next start.",
          "maximum": 3600,
          "minimum": 0,
          "title": "Pauseseconds",
          "type": "integer",
          "x-safe-integer": "unsigned"
        }
      },
      "required": ["burst", "pauseSeconds", "maxRunningTurns"],
      "title": "AccountStartThrottle",
      "type": "object"
    },
