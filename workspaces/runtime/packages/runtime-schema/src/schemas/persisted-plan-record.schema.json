{
  "$defs": {
    "PlanVersion": {
      "description": "A plan version is an integral JSON number within the safe-integer domain.",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "agent": {
      "type": ["string", "null"]
    },
    "id": {
      "type": "string"
    },
    "native": {
      "additionalProperties": true,
      "type": ["object", "null"]
    },
    "rootId": {
      "type": "string"
    },
    "steps": {
      "items": {},
      "type": "array"
    },
    "text": {
      "type": "string"
    },
    "updated": {
      "anyOf": [
        {
          "type": "integer",
          "x-safe-integer": "unsigned"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "$ref": "#/$defs/PlanVersion"
    }
  },
  "required": ["id", "rootId", "text", "version", "updated"],
  "title": "PlanRecord",
  "type": "object"
}
