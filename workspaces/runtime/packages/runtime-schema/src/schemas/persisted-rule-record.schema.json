{
  "$defs": {
    "LaunchIntent": {
      "additionalProperties": false,
      "properties": {
        "accountKey": {
          "type": ["string", "null"]
        },
        "agentId": {
          "type": "string"
        },
        "checkNumber": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "command": {
          "maxLength": 12000,
          "type": "string"
        },
        "epoch": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "liveness": {
          "type": "boolean"
        },
        "monitorId": {
          "type": "string"
        },
        "ruleId": {
          "type": "string"
        },
        "threadId": {
          "type": ["string", "null"]
        },
        "timeoutMs": {
          "maximum": 86400000,
          "minimum": 1000,
          "type": "integer"
        }
      },
      "required": [
        "accountKey",
        "agentId",
        "checkNumber",
        "command",
        "epoch",
        "liveness",
        "monitorId",
        "ruleId",
        "threadId",
        "timeoutMs"
      ],
      "type": "object"
    },
    "OwnerHold": {
      "enum": ["failed_input_held", "native_failure_hold", "archived"],
      "type": "string"
    },
    "RuleKind": {
      "enum": ["interval", "once", "file", "event", "low_workers"],
      "type": "string"
    },
    "RuleStatus": {
      "enum": ["active", "paused", "completed"],
      "type": "string"
    },
    "StoredJsonInteger": {
      "description": "A JSON Schema integer, preserving integral decimal spellings and large values.",
      "type": "integer"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "activeWorkers": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "agent": {
      "type": "string"
    },
    "alerted": {
      "type": "boolean"
    },
    "at": {
      "type": "number"
    },
    "checks": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "command": {
      "maxLength": 12000,
      "type": "string"
    },
    "created": {
      "type": "number"
    },
    "durationMinutes": {
      "maximum": 525600,
      "minimum": 1,
      "type": "integer"
    },
    "epoch": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "error": {
      "type": ["string", "null"]
    },
    "event": {
      "type": "string"
    },
    "eventText": {
      "maxLength": 12000,
      "type": "string"
    },
    "fileActivityAt": {
      "type": "number"
    },
    "fileGeneration": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "fingerprint": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer"
        },
        {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        }
      ],
      "type": ["array", "null"]
    },
    "id": {
      "type": "string"
    },
    "inFlight": {
      "type": "boolean"
    },
    "intervalSeconds": {
      "maximum": 31536000,
      "minimum": 10,
      "type": "integer"
    },
    "kind": {
      "$ref": "#/$defs/RuleKind"
    },
    "lastAt": {
      "type": "number"
    },
    "lastEvent": {
      "type": "string"
    },
    "lastExitCode": {
      "anyOf": [
        {
          "$ref": "#/$defs/StoredJsonInteger"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastFinished": {
      "type": "number"
    },
    "lastOutput": {
      "maxLength": 12000,
      "type": "string"
    },
    "lastStallError": {
      "type": ["string", "null"]
    },
    "lastStallExitCode": {
      "anyOf": [
        {
          "$ref": "#/$defs/StoredJsonInteger"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastStallFinished": {
      "type": "number"
    },
    "launchIntent": {
      "anyOf": [
        {
          "$ref": "#/$defs/LaunchIntent"
        },
        {
          "type": "null"
        }
      ]
    },
    "livenessCommand": {
      "maxLength": 12000,
      "type": "string"
    },
    "lowSince": {
      "type": ["number", "null"]
    },
    "minimumWorkers": {
      "maximum": 255,
      "minimum": 1,
      "type": "integer"
    },
    "name": {
      "maxLength": 120,
      "type": "string"
    },
    "nextAt": {
      "type": "number"
    },
    "ownerHold": {
      "anyOf": [
        {
          "$ref": "#/$defs/OwnerHold"
        },
        {
          "type": "null"
        }
      ]
    },
    "path": {
      "type": ["string", "null"]
    },
    "restartCheck": {
      "additionalProperties": true,
      "type": ["object", "null"]
    },
    "rootId": {
      "type": "string"
    },
    "stallEventKey": {
      "type": "string"
    },
    "stallProbe": {
      "type": "boolean"
    },
    "stallText": {
      "type": "string"
    },
    "stallTimeoutSeconds": {
      "maximum": 31536000,
      "minimum": 0,
      "type": "integer"
    },
    "stallWakeGeneration": {
      "maximum": 9007199254740991,
      "minimum": -1,
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/RuleStatus"
    },
    "text": {
      "type": "string"
    },
    "wakes": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": ["id"],
  "title": "RuleRecord",
  "type": "object"
}
