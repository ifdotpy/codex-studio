{
  "$defs": {
    "LaunchIntent": {
      "additionalProperties": false,
      "properties": {
        "accountKey": {
          "type": ["string", "null"]
        },
        "agentId": {
          "type": "string"
        },
        "checkNumber": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "command": {
          "maxLength": 12000,
          "type": "string"
        },
        "epoch": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "liveness": {
          "type": "boolean"
        },
        "monitorId": {
          "type": "string"
        },
        "ruleId": {
          "type": "string"
        },
        "threadId": {
          "type": ["string", "null"]
        },
        "timeoutMs": {
          "maximum": 86400000,
          "minimum": 1000,
          "type": "integer"
        }
      },
      "required": [
        "accountKey",
        "agentId",
        "checkNumber",
        "command",
        "epoch",
        "liveness",
        "monitorId",
        "ruleId",
        "threadId",
        "timeoutMs"
      ],
      "type": "object"
    },
    "OwnerHold": {
      "enum": ["failed_input_held", "native_failure_hold", "archived"],
      "type": "string"
    },
    "RestartCheck": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "epoch": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "monitorId": {
          "type": "string"
        }
      },
      "required": ["epoch", "checks", "monitorId"],
      "type": "object"
    },
    "RuleStatus": {
      "enum": ["active", "paused", "completed"],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "interval",
          "type": "string"
        }
      },
      "required": ["kind"],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "once",
          "type": "string"
        }
      },
      "required": ["kind"],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "file",
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": ["kind", "path"],
      "type": "object"
    },
    {
      "properties": {
        "kind": {
          "const": "event",
          "type": "string"
        }
      },
      "required": ["kind"],
      "type": "object"
    },
    {
      "properties": {
        "durationMinutes": {
          "maximum": 525600,
          "minimum": 1,
          "type": "integer"
        },
        "kind": {
          "const": "low_workers",
          "type": "string"
        },
        "minimumWorkers": {
          "maximum": 255,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": ["kind", "minimumWorkers", "durationMinutes"],
      "type": "object"
    }
  ],
  "properties": {
    "activeWorkers": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "agent": {
      "type": "string"
    },
    "alerted": {
      "type": "boolean"
    },
    "at": {
      "type": "number"
    },
    "checks": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "command": {
      "maxLength": 12000,
      "type": "string"
    },
    "created": {
      "type": "number"
    },
    "epoch": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "error": {
      "type": ["string", "null"]
    },
    "event": {
      "type": "string"
    },
    "eventText": {
      "maxLength": 12000,
      "type": "string"
    },
    "fileActivityAt": {
      "type": "number"
    },
    "fileGeneration": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "fingerprint": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "format": "int64",
          "type": "integer"
        },
        {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      ],
      "type": ["array", "null"]
    },
    "id": {
      "type": "string"
    },
    "inFlight": {
      "type": "boolean"
    },
    "intervalSeconds": {
      "maximum": 31536000,
      "minimum": 10,
      "type": "integer"
    },
    "lastAt": {
      "type": "number"
    },
    "lastEvent": {
      "type": "string"
    },
    "lastExitCode": {
      "format": "int64",
      "type": ["integer", "null"]
    },
    "lastFinished": {
      "type": "number"
    },
    "lastOutput": {
      "maxLength": 12000,
      "type": "string"
    },
    "lastStallError": {
      "type": ["string", "null"]
    },
    "lastStallExitCode": {
      "format": "int64",
      "type": ["integer", "null"]
    },
    "lastStallFinished": {
      "type": "number"
    },
    "launchIntent": {
      "anyOf": [
        {
          "$ref": "#/$defs/LaunchIntent"
        },
        {
          "type": "null"
        }
      ]
    },
    "livenessCommand": {
      "maxLength": 12000,
      "type": "string"
    },
    "lowSince": {
      "type": ["number", "null"]
    },
    "name": {
      "maxLength": 120,
      "type": "string"
    },
    "nextAt": {
      "type": "number"
    },
    "ownerHold": {
      "anyOf": [
        {
          "$ref": "#/$defs/OwnerHold"
        },
        {
          "type": "null"
        }
      ]
    },
    "restartCheck": {
      "anyOf": [
        {
          "$ref": "#/$defs/RestartCheck"
        },
        {
          "type": "null"
        }
      ]
    },
    "rootId": {
      "type": "string"
    },
    "stallEventKey": {
      "type": "string"
    },
    "stallProbe": {
      "type": "boolean"
    },
    "stallText": {
      "type": "string"
    },
    "stallTimeoutSeconds": {
      "maximum": 31536000,
      "minimum": 0,
      "type": "integer"
    },
    "stallWakeGeneration": {
      "maximum": 9007199254740991,
      "minimum": -1,
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/RuleStatus"
    },
    "text": {
      "type": "string"
    },
    "wakes": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "agent",
    "checks",
    "command",
    "created",
    "epoch",
    "event",
    "fileGeneration",
    "id",
    "inFlight",
    "intervalSeconds",
    "livenessCommand",
    "name",
    "nextAt",
    "stallTimeoutSeconds",
    "stallWakeGeneration",
    "status",
    "text",
    "wakes"
  ],
  "title": "RuleRecord",
  "type": "object"
}
