{
  "$defs": {
    "MonitorOperationRecord": {
      "additionalProperties": true,
      "properties": {
        "accountKey": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "agent": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "connectionId": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "epoch": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "accountKey",
        "agent",
        "connectionId",
        "epoch"
      ],
      "type": "object"
    },
    "MonitorWakeOn": {
      "enum": [
        "exit",
        "failure"
      ],
      "type": "string"
    },
    "StoredJsonInteger": {
      "description": "A JSON Schema integer, preserving integral decimal spellings and large values.",
      "type": "integer"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "activityAt": {
      "minimum": 0,
      "type": "number"
    },
    "activityGeneration": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "agent": {
      "type": [
        "string",
        "null"
      ]
    },
    "bytes": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "cancelRequested": {
      "type": "boolean"
    },
    "command": {
      "maxLength": 12000,
      "type": "string"
    },
    "configurationPending": {
      "type": "boolean"
    },
    "created": {
      "minimum": 0,
      "type": "number"
    },
    "cwd": {
      "type": "string"
    },
    "epoch": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "error": {
      "maxLength": 12000,
      "type": [
        "string",
        "null"
      ]
    },
    "exitCode": {
      "anyOf": [
        {
          "$ref": "#/$defs/StoredJsonInteger"
        },
        {
          "type": "null"
        }
      ]
    },
    "finished": {
      "minimum": 0,
      "type": [
        "number",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "inputAttempt": {
      "additionalProperties": true,
      "type": [
        "object",
        "null"
      ]
    },
    "interactive": {
      "type": "boolean"
    },
    "lastExitCode": {
      "anyOf": [
        {
          "$ref": "#/$defs/StoredJsonInteger"
        },
        {
          "type": "null"
        }
      ]
    },
    "livenessCommand": {
      "maxLength": 12000,
      "type": "string"
    },
    "log": {
      "type": "string"
    },
    "operation": {
      "anyOf": [
        {
          "$ref": "#/$defs/MonitorOperationRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "ruleId": {
      "type": [
        "string",
        "null"
      ]
    },
    "stallProbeGeneration": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "stallProbeStarted": {
      "minimum": 0,
      "type": [
        "number",
        "null"
      ]
    },
    "stallTimeoutSeconds": {
      "maximum": 31536000,
      "minimum": 0,
      "type": "integer"
    },
    "stallWakeGeneration": {
      "maximum": 9007199254740991,
      "minimum": -1,
      "type": "integer"
    },
    "status": {
      "anyOf": [
        {
          "enum": [
            "approval",
            "starting",
            "running",
            "completed",
            "failed",
            "cancelled",
            "lost"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "stdinCloseRequested": {
      "type": [
        "string",
        "null"
      ]
    },
    "stdinClosed": {
      "type": "boolean"
    },
    "successExitCodes": {
      "items": {
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array"
    },
    "tail": {
      "maxLength": 12000,
      "type": "string"
    },
    "timeout_ms": {
      "maximum": 86400000,
      "minimum": 1000,
      "type": "integer"
    },
    "wakeOn": {
      "$ref": "#/$defs/MonitorWakeOn"
    }
  },
  "required": [
    "id"
  ],
  "title": "MonitorRecord",
  "type": "object"
}