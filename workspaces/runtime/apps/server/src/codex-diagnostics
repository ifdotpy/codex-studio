#!/usr/bin/env python3
"""Print the shareable diagnostics snapshot from a running Studio backend."""

import argparse
import json
import urllib.request


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--port", type=int, default=4620)
    args = parser.parse_args()
    with urllib.request.urlopen(
            f"http://127.0.0.1:{args.port}/api/diagnostics", timeout=30) as response:
        print(json.dumps(json.load(response), indent=2, sort_keys=True))


if __name__ == "__main__":
    main()
