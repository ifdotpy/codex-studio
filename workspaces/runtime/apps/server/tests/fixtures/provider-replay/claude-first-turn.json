    },
    "model/list": {
      "direction": "in",
      "responseFor": "model/list",
      "message": {
        "result": {
          "data": [
            {
              "id": "default",
              "model": "default",
              "resolvedModel": "claude-replay",
              "displayName": "Claude · Default",
