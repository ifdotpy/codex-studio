{
  "source": "synthetic provider replies for portable history import contracts",
  "boundaryOnly": true,
  "rpcReplies": {
    "thread/list": {
      "direction": "in",
      "responseFor": "thread/list",
      "timestamp": 0,
      "message": {
        "result": {
          "data": [{ "id": "source-thread", "title": "Fixture thread" }],
          "nextCursor": null
        }
      }
    },
    "thread/read": {
      "direction": "in",
      "responseFor": "thread/read",
      "timestamp": 0,
      "message": {
        "result": { "thread": { "id": "$threadId", "cwd": "$cwd" } }
      }
    },
    "thread/turns/list": {
      "direction": "in",
      "responseFor": "thread/turns/list",
      "timestamp": 0,
      "message": {
        "result": {
          "data": [],
          "nextCursor": null
        }
      },
      "pages": {
        "": {
          "result": {
            "data": [
              {
                "id": "native-new",
                "items": [
                  {
                    "type": "userMessage",
                    "content": [
                      { "type": "text", "text": "Synthetic source question" }
                    ]
                  },
                  { "type": "agentMessage", "text": "Synthetic source answer" }
                ]
              }
            ],
            "nextCursor": "older"
          }
        },
        "older": {
          "result": {
            "data": [
              { "id": "source-turn", "items": [] },
              { "id": "older-turn", "items": [] }
            ],
            "nextCursor": null
          }
        }
      }
    },
    "thread/fork": {
      "direction": "in",
      "responseFor": "thread/fork",
      "timestamp": 0,
      "message": { "result": { "thread": { "id": "branch-thread" } } }
    }
  }
}
