{
  "source": "hand-authored supervisor event frames based on workspaces/runtime/apps/server/tests/process-supervisor-contract.py",
  "supervisorReplay": true,
  "rpcReplies": {
    "thread/settings/update": {
      "direction": "in",
      "responseFor": "thread/settings/update",
      "timestamp": 0,
      "message": { "result": {} }
    },
    "thread/compact/start": {
      "direction": "in",
      "responseFor": "thread/compact/start",
      "timestamp": 0,
      "message": { "result": {} }
    },
    "review/start": {
      "direction": "in",
      "responseFor": "review/start",
      "timestamp": 0,
      "message": {
        "result": { "turn": { "id": "$turnId", "status": "inProgress" } }
      }
    }
  },
  "events": [
    {
      "method": "item/agentMessage/delta",
      "params": {
        "threadId": "$threadId",
        "turnId": "$turnId",
        "itemId": "resume-answer",
        "delta": "Recovered output."
      }
    },
    {
      "method": "item/completed",
      "params": {
        "threadId": "$threadId",
        "turnId": "$turnId",
        "item": {
          "id": "resume-answer",
          "type": "agentMessage",
          "text": "Recovered output."
        }
      }
    },
    {
      "method": "turn/completed",
      "params": {
        "threadId": "$threadId",
        "turn": { "id": "$turnId", "status": "completed" }
      }
    }
  ],
  "expectedStatus": "completed",
  "allowedOrphanResponses": [
    {
      "id": "supervisor-orphan-3",
      "result": { "turn": { "id": "replay-turn-1", "status": "inProgress" } }
    }
  ],
  "expectedMissingReplies": [{ "method": "turn/start", "id": 3 }],
  "assert": {
    "eventKinds": ["user"],
    "answerItems": [
      {
        "owner": "lead",
        "nativeId": "resume-answer",
        "text": "Recovered output."
      }
    ]
  }
}
