[Unit]
Description=Studio layr privilege broker
After=network-online.target codex-studio-layr.service
Requires=codex-studio-layr.service
Wants=network-online.target
RequiresMountsFor=/var/lib/codex-studio
# Never give up: a broker that stays down pauses every VM chat while the guest still answers
# (2026-10-14). The Mac has no other root path into the guest.
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Environment=LAYR_ROOT=/var/lib/codex-studio/layr
Environment=LAYR_SOCKET=/run/layr/layr.sock
ExecStart=/usr/bin/python3 /opt/codex-studio/vm/guest/layr_admin.py serve
Restart=on-failure
RestartSec=2
KillMode=process
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

