#!/usr/bin/env python3
"""Register host agents and their actual parent relationships on the canvas."""
import argparse
import json
import os
import sys
import uuid
sys.dont_write_bytecode = True
from codex_api_client import desktop_state_dir, pull_entities, session_token
from codex_canvas import Canvas, identity
from studio_api.sync.resources.models import ResourceRef, StateResource, WorkspaceResource
from studio_api.sync.resources.relay.client import NotifyCommittedWriteError, notify_external_write

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('action', choices=['list', 'agent'])
parser.add_argument('--url', default=os.environ.get('CODEX_CANVAS_URL', 'http://127.0.0.1:4620'))
parser.add_argument('--id', help='Stable identity returned by the host')
parser.add_argument('--name')
parser.add_argument('--parent', help='Exact board identity of the agent that created this agent')
parser.add_argument('--thread', help='Local Codex thread identity, when the host provides one')
parser.add_argument('--status', default='unknown', choices=['unknown', 'running', 'waiting', 'completed', 'blocked', 'failed', 'interrupted'])
args = parser.parse_args()
try:
    if os.environ.get("CODEX_BOARD_OWNER"):
        raise ValueError("CODEX_BOARD_OWNER is unsupported. Start the worker with the current launcher.")
    if os.environ.get("CODEX_AGENT_OWNER"):
        raise ValueError("Agent sessions must use their team runtime tools. The graph CLI is for the user.")
    canvas = Canvas(read_only=args.action == 'list')
    if args.action == 'list':
        token = session_token(args.url)
        state_dir = desktop_state_dir(args.url)
        if os.path.realpath(state_dir) != os.path.realpath(canvas.root):
            raise ValueError('Studio API state directory does not match the local graph workspace.')
        entities = pull_entities(args.url, token)
        agents = [entity['value'] for entity in entities if entity['collection'] == 'agent']
        chats = [entity['value'] for entity in entities if entity['collection'] == 'chat']
        edges = [entity['value'] for entity in entities if entity['collection'] == 'edge']
        edges.extend(
            {'id': identity('spawn', agent['parentId'], agent['id']), 'source': agent['parentId'],
             'target': agent['id'], 'kind': 'spawn'}
            for agent in agents if isinstance(agent.get('parentId'), str) and agent['parentId']
        )
        result = {'nodes': agents + chats, 'edges': edges}
    else:
        result = canvas.register_agent(args.id, args.name, args.parent, args.thread, args.status)
        notify_external_write(str(uuid.uuid4()), [
            ResourceRef(StateResource(kind="state")),
            ResourceRef(WorkspaceResource(kind="workspace", agentId=args.id)),
        ], source_root=canvas.root)
    print(json.dumps(result, ensure_ascii=False, indent=2))
except NotifyCommittedWriteError as error:
    sys.exit(f"Source change committed; UI invalidation is unconfirmed. Do not repeat the source operation. {error}")
except (ValueError, RuntimeError) as error:
    sys.exit(str(error))
