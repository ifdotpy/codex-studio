#!/usr/bin/env python3
"""Compatibility launcher for the Rust codex-diagnostics binary."""
import os
from pathlib import Path
import shutil
import subprocess
import sys


def main():
    project = Path(__file__).resolve().parents[1]
    target = Path(os.environ.get("CARGO_TARGET_DIR", project / "target"))
    if not target.is_absolute():
        target = project / target
    binary_name = "codex-diagnostics.exe" if os.name == "nt" else "codex-diagnostics"
    binary = target / "release" / binary_name
    if not binary.is_file():
        cargo = shutil.which("cargo")
        if cargo is None:
            sys.exit(
                "codex-diagnostics: binary is not built and Cargo is unavailable; "
                "install Rust 1.99.0 or install a prebuilt binary."
            )
        try:
            subprocess.run(
                [cargo, "build", "--locked", "--release", "-p", "studio-diagnostics"],
                cwd=project,
                check=True,
            )
        except subprocess.CalledProcessError as error:
            sys.exit(error.returncode)
    if not binary.is_file():
        sys.exit(f"codex-diagnostics: Cargo did not produce {binary}")
    os.execv(str(binary), [str(binary), *sys.argv[1:]])


if __name__ == "__main__":
    main()
