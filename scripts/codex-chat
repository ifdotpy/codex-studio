#!/usr/bin/env python3
"""Read or post to a canvas group chat, without starting a model."""
import argparse
import json
import os
import sys
import uuid
sys.dont_write_bytecode = True
from codex_canvas import Canvas

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("action", choices=["list", "read", "post"])
parser.add_argument("group", nargs="?")
parser.add_argument("text", nargs="?")
parser.add_argument("--owner", default=os.environ.get("CODEX_BOARD_OWNER"))
args = parser.parse_args()
try:
    canvas = Canvas()
    if args.action == "list":
        result = canvas.groups(canvas.threads())
    elif args.action == "read" and args.group:
        result = canvas.messages(args.group)
    elif args.action == "post" and args.group and args.text and args.owner:
        rows = [t for t in canvas.threads() if t.get("boardOwner") == args.owner]
        if len(rows) != 1:
            raise ValueError("The owner must identify one current worker.")
        result = canvas.post(args.group, args.text, str(uuid.uuid4()), author=rows[0]["id"], notify=False)
    else:
        parser.error("read needs GROUP. post needs GROUP TEXT and --owner (or CODEX_BOARD_OWNER).")
    print(json.dumps(result, ensure_ascii=False, indent=2))
except (ValueError, RuntimeError) as error:
    sys.exit(str(error))
