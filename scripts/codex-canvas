#!/usr/bin/env python3
"""Serve the local Codex agent canvas."""
import sys
import os
from pathlib import Path
sys.dont_write_bytecode = True
from codex_python import resolve_python
selected_python = resolve_python(Path(__file__).resolve().parent)
if Path(selected_python).resolve() != Path(sys.executable).resolve():
    os.execv(str(selected_python), [str(selected_python), "-B", *sys.argv])
from codex_startup_memory import mark as startup_memory_mark
startup_memory_mark("backend-entry")
from codex_canvas import main

if __name__ == "__main__":
    main()
