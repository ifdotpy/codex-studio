#!/usr/bin/env python3
"""Send one mailbox message to a worker owned by an active launcher.

usage: codex-steer [--wave WAVE] WORKER MESSAGE
"""

import argparse
import json
import os
import re
import sys
import time
import uuid
# Keep import caches out of the installed skill checkout.
sys.dont_write_bytecode = True
from codex_state import state_dir, process_is_alive


COMPONENT_PATTERN = re.compile(r"[A-Za-z0-9._-]+")


def component(value: str) -> str:
    if not COMPONENT_PATTERN.fullmatch(value):
        raise argparse.ArgumentTypeError("use only letters, digits, dot, underscore, or hyphen")
    return value


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--wave", type=component, default=os.environ.get("CODEX_WAVE"))
    parser.add_argument("worker", type=component)
    parser.add_argument("message", nargs="+")
    args = parser.parse_args()
    message = " ".join(args.message).strip()
    if not message:
        parser.error("MESSAGE must not be empty")

    root = state_dir()
    if args.wave:
        paths = [root / f"codex-swarm-status.{args.wave}.json"]
    else:
        paths = sorted(root.glob("codex-swarm-status.*.json"))

    matches = []
    for path in paths:
        try:
            threads = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if not isinstance(threads, list):
            continue
        for thread in threads:
            if not isinstance(thread, dict):
                continue
            if thread.get("name") == args.worker:
                wave = thread.get("wave") or path.stem.removeprefix("codex-swarm-status.")
                if not isinstance(wave, str) or not COMPONENT_PATTERN.fullmatch(wave):
                    print(f"invalid wave in {path}", file=sys.stderr)
                    return 2
                matches.append((wave, thread))

    if not matches:
        print(f"no worker named {args.worker}", file=sys.stderr)
        return 2
    if len(matches) > 1:
        waves = ", ".join(sorted(wave for wave, _thread in matches))
        print(f"worker name is present in multiple waves: {waves}; use --wave", file=sys.stderr)
        return 2

    wave, thread = matches[0]
    run_id = thread.get("runId")
    if not isinstance(run_id, str) or not COMPONENT_PATTERN.fullmatch(run_id):
        print(f"worker {args.worker} has no valid run id", file=sys.stderr)
        return 2
    pid = int(thread.get("launcherPid") or 0)
    if not process_is_alive(pid):
        print(f"launcher for wave {wave} is not active", file=sys.stderr)
        return 1

    inbox = root / f"codex-inbox.{wave}.{run_id}"
    inbox.mkdir(parents=True, exist_ok=True)
    destination = inbox / f"{args.worker}.json"
    temporary = inbox / f".{args.worker}.{os.getpid()}.tmp"
    payload = {
        "id": str(uuid.uuid4()),
        "text": message + "\n",
        "attempts": 0,
        "nextAttemptAt": 0,
        "createdAt": time.time(),
    }
    temporary.write_text(json.dumps(payload) + "\n", encoding="utf-8")
    try:
        os.link(temporary, destination)
    except FileExistsError:
        print(f"a pending message already exists for {args.worker}", file=sys.stderr)
        return 1
    finally:
        temporary.unlink(missing_ok=True)

    print(f"CODEX STEERED wave={wave} worker={args.worker}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except RuntimeError as error:
        sys.exit(f"codex-steer: {error}")
