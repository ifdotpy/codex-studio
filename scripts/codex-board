#!/usr/bin/env python3
"""Store exclusive resource claims for concurrent Codex workers.

usage:
  codex-board claim RESOURCE OWNER [NOTE]
  codex-board renew RESOURCE OWNER
  codex-board takeover RESOURCE NEW_OWNER EXPECTED_OWNER [NOTE]
  codex-board release RESOURCE OWNER
  codex-board note OWNER TEXT
  codex-board show
"""

import fcntl
import json
import os
import sys
import tempfile
import time
from pathlib import Path


def state_dir() -> Path:
    board = os.environ.get("CODEX_BOARD_STATE_DIR")
    if board:
        return Path(board).expanduser().resolve()
    configured = os.environ.get("CODEX_AGENTS_STATE_DIR")
    if configured:
        return (Path(configured).expanduser().resolve() / "board")
    base = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")).expanduser()
    return (base / "codex-agents" / "board").resolve()


ROOT = state_dir()
BOARD = ROOT / "codex-board.json"
LOCK = ROOT / "codex-board.lock"


def load() -> dict:
    try:
        value = json.loads(BOARD.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {"claims": {}, "notes": []}
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError(f"cannot read {BOARD}: {error}") from error
    if not isinstance(value, dict) or not isinstance(value.get("claims"), dict):
        raise RuntimeError(f"invalid board file: {BOARD}")
    value.setdefault("notes", [])
    if not isinstance(value["notes"], list):
        raise RuntimeError(f"invalid board file: {BOARD}")
    for claim in value["claims"].values():
        if (
            not isinstance(claim, dict)
            or not isinstance(claim.get("worker"), str)
            or not isinstance(claim.get("at"), (int, float))
        ):
            raise RuntimeError(f"invalid board file: {BOARD}")
    for note in value["notes"]:
        if (
            not isinstance(note, dict)
            or not isinstance(note.get("worker"), str)
            or not isinstance(note.get("at"), (int, float))
            or not isinstance(note.get("text"), str)
        ):
            raise RuntimeError(f"invalid board file: {BOARD}")
    return value


def save(state: dict) -> None:
    handle, temporary = tempfile.mkstemp(prefix="codex-board.", suffix=".tmp", dir=ROOT)
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as output:
            json.dump(state, output, indent=1)
            output.write("\n")
        os.replace(temporary, BOARD)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def need(args: list[str], count: int) -> bool:
    if len(args) >= count:
        return True
    print(__doc__.strip(), file=sys.stderr)
    return False


def run(args: list[str]) -> int:
    if not args:
        print(__doc__.strip())
        return 2

    action = args[0]
    now = time.time()
    state = load()

    if action == "claim":
        if not need(args, 3):
            return 2
        resource, owner = args[1], args[2]
        note = " ".join(args[3:])
        if not resource.strip() or not owner.strip():
            print("RESOURCE and OWNER must not be empty", file=sys.stderr)
            return 2
        held = state["claims"].get(resource)
        if held and held["worker"] != owner:
            age = int(now - held["at"])
            print(f"HELD {resource} by {held['worker']} for {age}s: {held.get('note', '')}")
            return 1
        state["claims"][resource] = {"worker": owner, "at": now, "note": note}
        save(state)
        print(f"CLAIMED {resource} {owner}")
        return 0

    if action == "renew":
        if not need(args, 3):
            return 2
        resource, owner = args[1], args[2]
        if not resource.strip() or not owner.strip():
            print("RESOURCE and OWNER must not be empty", file=sys.stderr)
            return 2
        held = state["claims"].get(resource)
        if held and held["worker"] == owner:
            held["at"] = now
            save(state)
            print(f"RENEWED {resource} {owner}")
            return 0
        print(f"NOT_HELD {resource} {owner}")
        return 1

    if action == "takeover":
        if not need(args, 4):
            return 2
        resource, new_owner, expected_owner = args[1], args[2], args[3]
        note = " ".join(args[4:])
        if not resource.strip() or not new_owner.strip() or not expected_owner.strip():
            print("RESOURCE and OWNER must not be empty", file=sys.stderr)
            return 2
        held = state["claims"].get(resource)
        if not held or held["worker"] != expected_owner:
            actual = held["worker"] if held else "nobody"
            print(f"TAKEOVER_REFUSED {resource} expected={expected_owner} actual={actual}")
            return 1
        state["claims"][resource] = {"worker": new_owner, "at": now, "note": note}
        save(state)
        print(f"TAKEN_OVER {resource} {new_owner}")
        return 0

    if action == "release":
        if not need(args, 3):
            return 2
        resource, owner = args[1], args[2]
        if not resource.strip() or not owner.strip():
            print("RESOURCE and OWNER must not be empty", file=sys.stderr)
            return 2
        held = state["claims"].get(resource)
        if held and held["worker"] == owner:
            del state["claims"][resource]
            save(state)
            print(f"RELEASED {resource} {owner}")
            return 0
        print(f"NOT_HELD {resource} {owner}")
        return 1

    if action == "note":
        if not need(args, 3):
            return 2
        owner = args[1]
        text = " ".join(args[2:])
        if not owner.strip() or not text.strip():
            print("OWNER and TEXT must not be empty", file=sys.stderr)
            return 2
        state["notes"] = (state["notes"] + [{"worker": owner, "at": now, "text": text}])[-40:]
        save(state)
        print("NOTED")
        return 0

    if action == "show":
        for resource, claim in sorted(state["claims"].items()):
            age = int(now - claim["at"])
            print(
                f"CLAIM {resource:20} {claim['worker']:20} {age}s "
                f"{claim.get('note', '')}"
            )
        for entry in state["notes"][-12:]:
            print(f"NOTE  {entry['worker']:20} {int(now - entry['at'])}s ago: {entry['text']}")
        return 0

    print(__doc__.strip(), file=sys.stderr)
    return 2


def main() -> int:
    ROOT.mkdir(parents=True, exist_ok=True)
    try:
        with LOCK.open("a+", encoding="utf-8") as lock:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
            return run(sys.argv[1:])
    except RuntimeError as error:
        print(f"CODEX BOARD ERROR {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
