#!/usr/bin/env python3
"""Control the same managed agents as the canvas, without another app-server."""
import argparse
import json
import os
import sys
from urllib.error import HTTPError
from codex_api_client import pull_entities, request_json, session_token
from codex_agent_modes import DEFAULT_SUBAGENT_CONCURRENCY, MAX_SUBAGENT_CONCURRENCY

p = argparse.ArgumentParser(description=__doc__)
p.add_argument('--url', default=os.environ.get('CODEX_CANVAS_URL', 'http://127.0.0.1:4620'))
s = p.add_subparsers(dest='command', required=True)
s.add_parser('list')
s.add_parser('accounts')
c = s.add_parser('project-account', help='Read or set the default account for a project')
c.add_argument('path')
c.add_argument('--account', help='Set the account key from codex-control accounts')
for command in ('models', 'limits'):
    c = s.add_parser(command)
    c.add_argument('--account', help='Account key from codex-control accounts')
c = s.add_parser('create')
c.add_argument('task')
c.add_argument('--account', help='Account key from codex-control accounts')
c.add_argument('--cwd', default=os.getcwd())
c.add_argument('--name', default='Lead')
c.add_argument('--model')
c.add_argument('--effort')
c.add_argument('--concurrency', type=int, default=DEFAULT_SUBAGENT_CONCURRENCY,
                help=f'Simultaneous subagent turns (0..{MAX_SUBAGENT_CONCURRENCY}; default {DEFAULT_SUBAGENT_CONCURRENCY})')
c.add_argument('--max-agents', type=int)
c.add_argument('--token-budget', type=int)
c = s.add_parser('send')
c.add_argument('agent')
c.add_argument('text')
c = s.add_parser('stop')
c.add_argument('agent')
c.add_argument('--only', action='store_true')
c = s.add_parser('monitor')
c.add_argument('agent')
c.add_argument('shell_command')
c.add_argument('--timeout-minutes', type=int, default=60)
c = s.add_parser('configure')
c.add_argument('agent')
c.add_argument('--concurrency', type=int,
                help=f'Simultaneous subagent turns (0..{MAX_SUBAGENT_CONCURRENCY})')
c.add_argument('--max-agents', type=int)
c.add_argument('--token-budget', type=int)
c.add_argument('--request-id', help='Reuse with --expected-mode-revision after an uncertain response')
c.add_argument('--expected-mode-revision', type=int, help='Reuse with --request-id after an uncertain response')
c = s.add_parser('transcript')
c.add_argument('agent')
c = s.add_parser('requests', help='Recover saved tool results without repeating their actions')
c.add_argument('agent')
c.add_argument('request_id', nargs='?')
a = p.parse_args()

def request(path, data=None, token=''):
    return request_json(a.url, path, data, token)

try:
    if os.environ.get('CODEX_BOARD_OWNER'):
        raise ValueError('CODEX_BOARD_OWNER is unsupported. Start the worker with the current launcher.')
    if os.environ.get('CODEX_AGENT_OWNER'):
        raise ValueError('Agents must use their runtime tools; codex-control is for the user')
    import uuid
    from urllib.parse import quote
    token = session_token(a.url) if a.command != 'requests' else ''
    threads = []
    if a.command == 'list' or (a.command == 'configure' and a.concurrency is not None):
        threads = [entity['value'] for entity in pull_entities(a.url, token)
                   if entity['collection'] == 'agent']
    if a.command == 'list':
        result = [{'id': t['id'], 'name': t['name'], 'parent': t.get('parentId'), 'status': t['status'],
                   'model': t.get('model'), 'accountKey': t.get('accountKey'), 'tokens': t.get('tokensUsed')} for t in threads]
    elif a.command == 'accounts':
        result = request('/api/accounts')
    elif a.command == 'requests':
        query = '?agent=' + quote(a.agent)
        if a.request_id:
            query += '&request_id=' + quote(a.request_id)
        result = request('/api/tool-requests' + query)
    elif a.command == 'project-account':
        from pathlib import Path
        path = str(Path(a.path).expanduser().resolve())
        project = next((v for v in request('/api/projects')['items'] if v['path'] == path), None)
        if a.account:
            result = request('/api/projects', dict(action='set_account', path=path, account_key=a.account,
                expected_revision=project.get('accountRevision', 0) if project else 0), token)
        elif project:
            result = project
        else:
            raise ValueError('Project is not registered. Supply --account to register its default')
    elif a.command in ('models', 'limits'):
        account = a.account or request('/api/accounts')['defaultAccountKey']
        result = request('/api/' + a.command + '?account_key=' + quote(account))
    elif a.command == 'create':
        body = dict(id=str(uuid.uuid4()), name=a.name, cwd=a.cwd, prompt=a.task,
            concurrency=a.concurrency, tokenBudget=a.token_budget)
        if a.max_agents is not None:
            body['maxAgents'] = a.max_agents
        for key, value in (('account_key', a.account), ('model', a.model), ('effort', a.effort)):
            if value is not None:
                body[key] = value
        result = request('/api/agents', body, token)
    elif a.command == 'send':
        result = request('/api/messages', dict(id=str(uuid.uuid4()), room=a.agent, text=a.text), token)
    elif a.command == 'stop':
        result = request('/api/stop', dict(id=a.agent, descendants=not a.only), token)
    elif a.command == 'monitor':
        result = request('/api/monitor', dict(id=str(uuid.uuid4()), agent=a.agent, command=a.shell_command,
                                             timeout_ms=a.timeout_minutes * 60000), token)
    elif a.command == 'configure':
        data = {'id': a.agent}
        for source, target in [('max_agents', 'maxAgents'), ('token_budget', 'tokenBudget')]:
            value = getattr(a, source)
            if value is not None: data[target] = value
        if a.concurrency is not None:
            if data.keys() != {'id'}:
                raise ValueError('Set subagent concurrency separately from team storage and token limits')
            if bool(a.request_id) != (a.expected_mode_revision is not None):
                raise ValueError('Use --request-id and --expected-mode-revision together')
            lead = next((t for t in threads if t['id'] == a.agent), None)
            if not lead or not lead.get('isLead'):
                raise ValueError('Configure subagent concurrency on a lead chat')
            request_id = a.request_id or str(uuid.uuid4())
            revision = (a.expected_mode_revision if a.expected_mode_revision is not None
                        else lead.get('agentModeRevision', 0))
            print(f"codex-control: retry with --request-id {request_id} --expected-mode-revision {revision} if the response is uncertain",
                  file=sys.stderr)
            result = request('/api/conversation', {
                'id': a.agent, 'subagent_concurrency': a.concurrency,
                'expected_mode_revision': revision, 'request_id': request_id}, token)
        else:
            if a.request_id or a.expected_mode_revision is not None:
                raise ValueError('--request-id and --expected-mode-revision require --concurrency')
            result = request('/api/configure', data, token)
    else:
        result = request('/api/transcript?id=' + quote(a.agent))
    print(json.dumps(result, ensure_ascii=False, indent=2))
except (OSError, ValueError) as error:
    if isinstance(error, HTTPError):
        try: error = json.load(error).get('error', str(error))
        except ValueError: pass
    p.exit(1, f'codex-control: {error}\n')
