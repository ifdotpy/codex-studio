#!/usr/bin/env python3
"""luna — explore the Codex worker threads of a wave.

Read wave state from the canonical Codex state directory. Only `say` writes a
mailbox message; all other commands are read-only.

  luna                      dashboard: live threads, launcher, board, machine
  luna ls [--all]           one line per thread, every wave
  luna show NAME            one thread in full, with its final answer
  luna tail NAME [-n 20]    what that thread has been doing lately
  luna say NAME "text"      queue a follow-up turn for a live thread
  luna board                who holds the exclusive slots
  luna waves                threads grouped by wave
  luna watch [-i 20]        dashboard, refreshed until interrupted

Launcher lifecycle lives in codex-daemon (start | stop | status).
CODEX_AGENTS_STATE_DIR selects state; LUNA_HOME remains an explicit legacy alias.
There is no automatic search in another agent application's directories.
"""

import argparse
import datetime
import json
import os
import shutil
import subprocess
import sys
import time
from collections import deque
from pathlib import Path
from codex_state import ACTIVE, state_dir, board_dir, read_threads, effective_status, process_is_alive, final_answer

# ---------------------------------------------------------------- locating

try:
    HOME = str(state_dir("LUNA_HOME"))
    BOARD = str(board_dir(Path(HOME)) / "codex-board.json")
except RuntimeError as error:
    sys.exit(f"luna: {error}")


# ---------------------------------------------------------------- painting

COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def paint(text, code):
    return f"\033[{code}m{text}\033[0m" if COLOR else text


DIM, BOLD = "2", "1"
STATUS_COLOR = {
    "running": "32",         # green: alive and taking turns
    "capacity-retry": "33",  # yellow: the server refused a turn, it will retry
    "completed": "36",
    "failed": "31",
    "abandoned": "31",
    "superseded": "2",
}


def status_label(status):
    return paint(f"{status:<14}", STATUS_COLOR.get(status, "0"))


def age(stamp):
    if not stamp:
        return None
    try:
        when = datetime.datetime.fromisoformat(stamp.replace("Z", "+00:00"))
    except ValueError:
        return None
    return (datetime.datetime.now(datetime.timezone.utc) - when).total_seconds()


def human_age(seconds):
    if seconds is None:
        return "-"
    seconds = int(seconds)
    if seconds < 90:
        return f"{seconds}s"
    if seconds < 5400:
        return f"{seconds // 60}m"
    return f"{seconds // 3600}h"


def number(value):
    return f"{value:,}" if isinstance(value, int) else str(value)

# ---------------------------------------------------------------- reading

def live_launchers():
    return sorted({row["launcherPid"] for row in load_threads()
                   if process_is_alive(row.get("launcherPid"))})


def load_threads():
    return read_threads(Path(HOME))


def resolve_status(thread):
    status = effective_status(thread)
    idle = age(thread.get("lastEvent"))
    if status == "running" and idle is not None and idle > 1800:
        return "stalled"
    return status


def find(threads, name, wave=None):
    if wave:
        threads = [row for row in threads if row["wave"] == wave]
    exact = [row for row in threads if row.get("name") == name]
    matches = exact or [row for row in threads if name in row.get("name", "")]
    if len(matches) == 1:
        return matches[0]
    if matches:
        choices = ", ".join(f"{row['wave']}/{row['name']}" for row in matches)
        sys.exit(f"luna: ambiguous worker '{name}': {choices}; use --wave")
    sys.exit(f"luna: no thread named '{name}'")


def recent_events(thread, count):
    name = thread["name"]
    run_id = thread.get("runId")
    path = os.path.join(HOME, f"codex-swarm-events.{thread['wave']}.{run_id}.jsonl")
    if not run_id or not os.path.isfile(path):
        return []
    rows = deque(maxlen=count)
    with open(path) as handle:
        for line in handle:
            if f'"{name}"' not in line:
                continue
            try:
                row = json.loads(line)
            except json.JSONDecodeError:
                continue
            if row.get("name") == name:
                rows.append(row)
    return list(rows)


def branch_head(thread):
    cwd, branch = thread.get("cwd"), thread.get("branch")
    if not cwd or not os.path.isdir(cwd):
        return None
    try:
        out = subprocess.run(["git", "-C", cwd, "log", "-1", "--format=%h %cr %s"],
                             capture_output=True, text=True, timeout=10)
        head = out.stdout.strip()
        ahead = subprocess.run(["git", "-C", cwd, "rev-list", "--count", f"main..{branch}"],
                               capture_output=True, text=True, timeout=10).stdout.strip()
        dirty = subprocess.run(["git", "-C", cwd, "status", "--porcelain"],
                               capture_output=True, text=True, timeout=15).stdout.strip()
        return {"head": head, "ahead": ahead or "?", "dirty": len(dirty.splitlines())}
    except Exception:
        return None


def machine():
    load = os.getloadavg()[0]
    usage = shutil.disk_usage(os.path.expanduser("~"))
    return load, usage.free / 1024 ** 3


def board_claims():
    try:
        with open(BOARD, encoding="utf-8") as handle:
            value = json.load(handle)
        if not isinstance(value, dict) or not isinstance(value.get("claims"), dict):
            raise RuntimeError(f"invalid board file: {BOARD}")
        claims = value["claims"]
        if not all(isinstance(claim, dict) and isinstance(claim.get("worker"), str)
                   for claim in claims.values()):
            raise RuntimeError(f"invalid board claims: {BOARD}")
        return claims
    except FileNotFoundError:
        return {}
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError(f"cannot read {BOARD}: {error}") from error

# ---------------------------------------------------------------- commands

def cmd_ls(args):
    threads = load_threads()
    rows = []
    for thread in threads:
        status = resolve_status(thread)
        if not args.all and status in ("completed", "failed", "abandoned", "superseded", "interrupted", "blocked", "paused"):
            continue
        rows.append((thread, status))
    if not rows:
        print(paint("no live threads", DIM), "— luna ls --all to see finished ones")
        return 0
    for thread, status in rows:
        print(f"{thread.get('name',''):<20} {status_label(status)} "
              f"{paint(thread.get('wave',''), DIM):<12} "
              f"events={thread.get('events', 0):<7,} "
              f"idle={human_age(age(thread.get('lastEvent'))):<5} "
              f"tokens={number(thread.get('tokensUsed', 0)):>12}  "
              f"{paint(thread.get('branch',''), DIM)}")
    hidden = len(threads) - len(rows)
    if hidden and not args.all:
        print(paint(f"({hidden} finished or dead, --all to show)", DIM))
    return 0


def cmd_show(args):
    thread = find(load_threads(), args.name, args.wave)
    status = resolve_status(thread)
    print(paint(thread.get("name", ""), BOLD), status_label(status).strip())
    print(f"  wave     {thread.get('wave')}")
    print(f"  model    {thread.get('model') or thread.get('requestedModel')} effort={thread.get('effort')}")
    print(f"  goal     {thread.get('goalStatus')}   tokens={number(thread.get('tokensUsed', 0))}")
    print(f"  events   {thread.get('events', 0):,}   idle={human_age(age(thread.get('lastEvent')))}")
    print(f"  thread   {thread.get('threadId')}")
    print(f"  branch   {thread.get('branch')}")
    print(f"  cwd      {thread.get('cwd')}")
    if thread.get("error"):
        print(f"  error    {paint(thread['error'], '31')}")
    if thread.get("capacityRetries"):
        print(f"  retries  {thread['capacityRetries']} after capacity refusals")
    git = branch_head(thread)
    if git:
        dirty = f", {git['dirty']} uncommitted" if git["dirty"] else ", clean"
        print(f"  head     {git['head']}")
        print(f"  ahead    +{git['ahead']} vs main{dirty}")
    if thread.get("tail"):
        print(paint("\n  last words", DIM))
        print("  " + thread["tail"].strip().replace("\n", "\n  "))
    if not args.quiet:
        print(paint("\n  final answer", DIM))
        answer = final_answer(thread.get("threadId"), args.chars)
        print("  " + answer.replace("\n", "\n  "))
    return 0


def cmd_tail(args):
    thread = find(load_threads(), args.name, args.wave)
    rows = recent_events(thread, args.number)
    if not rows:
        print("(no events recorded for this thread)")
        return 0
    for row in rows:
        stamp = (row.get("at") or "")[11:19]
        detail = ""
        if row.get("capacityRetry"):
            detail = paint(f" capacity retry {row['capacityRetry']}, waiting {row.get('waitMs',0)//1000}s", "33")
        print(f"  {paint(stamp, DIM)}  {row.get('method','')}{detail}")
    return 0


def cmd_say(args):
    thread = find(load_threads(), args.name, args.wave)
    script = Path(__file__).resolve().with_name("codex-steer")
    env = {**os.environ, "CODEX_AGENTS_STATE_DIR": HOME}
    return subprocess.run(
        [sys.executable, str(script), "--wave", thread["wave"], "--", thread["name"], *args.message],
        env=env,
    ).returncode


def cmd_board(args):
    claims = board_claims()
    if not claims:
        print("no slot is claimed")
        return 0
    now = time.time()
    workers = {t.get("boardOwner"): t for t in load_threads() if t.get("boardOwner")}
    for slot, claim in sorted(claims.items()):
        held = human_age(now - claim.get("at", now))
        holder = claim.get("worker", "?")
        worker = workers.get(holder)
        # Nothing releases a claim when a thread dies, so a stale claim blocks
        # every later thread that waits politely for the slot.
        stale = paint("  STALE, launcher is not live", "31") if worker and not process_is_alive(worker.get("launcherPid")) else ""
        print(f"  {slot:<18} {holder:<20} held {held:<5} {paint(claim.get('note',''), DIM)}{stale}")
    return 0


def cmd_waves(args):
    waves = {}
    for thread in load_threads():
        waves.setdefault(thread["wave"], []).append(thread)
    # Newest wave first: the one you are working with should not be buried
    # under thirty finished ones.
    def freshness(item):
        ages = [age(t.get("lastEvent")) for t in item[1] if age(t.get("lastEvent")) is not None]
        return min(ages) if ages else 1e12

    for wave, threads in sorted(waves.items(), key=freshness):
        states = [resolve_status(t) for t in threads]
        live = sum(1 for s in states if s in ACTIVE or s == "stalled")
        mark = paint("live", "32") if live else paint("done", DIM)
        print(f"  {wave:<12} {mark}  {len(threads)} thread(s): "
              + ", ".join(f"{t['name']}={s}" for t, s in zip(threads, states)))
    return 0


def cmd_dashboard(args):
    pids = live_launchers()
    load, free = machine()
    state = paint(f"live launchers: {', '.join(map(str, pids))}", "32") if pids else paint("no live launchers", "31")
    print(f"{state}   load {load:.1f}   disk {free:.0f}G free   {HOME}")
    print()
    cmd_ls(argparse.Namespace(all=False))
    claims = board_claims()
    if claims:
        print()
        cmd_board(args)
    return 0


def cmd_watch(args):
    try:
        while True:
            os.system("clear")
            print(paint(datetime.datetime.now().strftime("%H:%M:%S"), DIM))
            cmd_dashboard(args)
            time.sleep(args.interval)
    except KeyboardInterrupt:
        return 0


def main():
    parser = argparse.ArgumentParser(prog="luna", description="explore Codex worker threads")
    sub = parser.add_subparsers(dest="command")

    p = sub.add_parser("ls", help="one line per thread")
    p.add_argument("--all", action="store_true", help="include finished and dead threads")
    p.set_defaults(func=cmd_ls)

    p = sub.add_parser("show", help="one thread in full")
    p.add_argument("--wave", help="select an exact wave when worker names repeat")
    p.add_argument("name")
    p.add_argument("--chars", type=int, default=3000, help="cap on the final answer")
    p.add_argument("-q", "--quiet", action="store_true", help="skip the final answer")
    p.set_defaults(func=cmd_show)

    p = sub.add_parser("tail", help="recent events of one thread")
    p.add_argument("--wave", help="select an exact wave when worker names repeat")
    p.add_argument("name")
    p.add_argument("-n", "--number", type=int, default=20)
    p.set_defaults(func=cmd_tail)

    p = sub.add_parser("say", help="queue a follow-up turn")
    p.add_argument("--wave", help="select an exact wave when worker names repeat")
    p.add_argument("name")
    p.add_argument("message", nargs="+")
    p.set_defaults(func=cmd_say)

    p = sub.add_parser("board", help="who holds the exclusive slots")
    p.set_defaults(func=cmd_board)

    p = sub.add_parser("waves", help="threads grouped by wave")
    p.set_defaults(func=cmd_waves)

    p = sub.add_parser("watch", help="dashboard, refreshed")
    p.add_argument("-i", "--interval", type=int, default=20)
    p.set_defaults(func=cmd_watch)

    args = parser.parse_args()
    for field in ("number", "chars", "interval"):
        if hasattr(args, field) and getattr(args, field) <= 0:
            parser.error(f"{field} must be positive")
    if not args.command:
        return cmd_dashboard(argparse.Namespace(all=False))
    return args.func(args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except RuntimeError as error:
        sys.exit(f"luna: {error}")
