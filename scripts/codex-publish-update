#!/usr/bin/env python3
"""Publish an exact, reviewed live patch after installation of its sources."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import sys
import tempfile


def publish(scripts, patch, release, scope):
    scripts = Path(scripts).resolve()
    if sys.version_info[:2] != (3, 14):
        raise ValueError("This live update publisher requires Python 3.14")
    if not re.fullmatch(r"codex_[a-z0-9_]+_update\.py", patch):
        raise ValueError("Choose a reviewed codex_*_update.py patch")
    if not release.strip() or len(release) > 200 or not scope.strip():
        raise ValueError("The release identity and patch scope are required")
    with (scripts / '.studio-update.lock').open('a') as lease:
        fcntl.flock(lease, fcntl.LOCK_EX)
        paths = sorted(p for p in scripts.iterdir()
                       if p.is_file() and (p.suffix == '.py' or p.name == 'codex-canvas'))
        if any(p.is_symlink() or p.resolve().parent != scripts for p in paths):
            raise ValueError("Live update source must be a local regular file")
        inputs = {p.name: hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}
        if patch not in inputs or 'codex-canvas' not in inputs:
            raise ValueError("The patch or backend entry point is missing")
        manifest = {'version': 1, 'id': release, 'scope': scope,
                    'python': list(sys.version_info[:2]), 'patch': patch, 'inputs': inputs}
        descriptor, temporary = tempfile.mkstemp(prefix='.studio-update-', suffix='.tmp', dir=scripts)
        try:
            with os.fdopen(descriptor, 'w') as output:
                json.dump(manifest, output, indent=2, sort_keys=True)
                output.write('\n')
                output.flush()
                os.fsync(output.fileno())
            os.replace(temporary, scripts / 'studio-live-update.json')
            directory = os.open(scripts, os.O_RDONLY)
            try:
                os.fsync(directory)
            finally:
                os.close(directory)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
    return {'id': release, 'scope': scope, 'inputs': len(inputs)}


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--scripts', type=Path, default=Path(__file__).resolve().parent)
    parser.add_argument('--patch', required=True)
    parser.add_argument('--id', required=True)
    parser.add_argument('--scope', required=True)
    args = parser.parse_args()
    try:
        print(json.dumps(publish(args.scripts, args.patch, args.id, args.scope)))
    except (OSError, ValueError) as error:
        parser.exit(1, str(error) + '\n')
