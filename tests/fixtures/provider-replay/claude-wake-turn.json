{
  "source": "hand-authored Studio bridge protocol shape based on tests/claude-bridge-contract.py",
  "provider": "claude",
  "sdkEvents": [
    { "type": "system", "subtype": "init", "claude_code_version": "replay" },
    {
      "type": "assistant",
      "message": {
        "id": "claude-first-answer",
        "content": [{ "type": "text", "text": "Claude first answer." }]
      }
    },
    {
      "type": "result",
      "subtype": "success",
      "usage": { "input_tokens": 16, "output_tokens": 5 },
      "result": "Claude first answer."
    },
    {
      "type": "system",
      "subtype": "task_started",
      "task_id": "wake-worker",
      "description": "Replay background completion",
      "task_type": "agent"
    },
    {
      "type": "system",
      "subtype": "task_notification",
      "task_id": "wake-worker",
      "status": "completed",
      "summary": "Background work finished"
    },
    {
      "type": "assistant",
      "message": {
        "id": "claude-wake-answer",
        "content": [{ "type": "text", "text": "Claude wake answer." }]
      }
    },
    {
      "type": "result",
      "subtype": "success",
      "usage": { "input_tokens": 9, "output_tokens": 3 },
      "result": "Claude wake answer."
    }
  ],
  "events": [
    {
      "method": "item/completed",
      "params": {
        "threadId": "$threadId",
        "turnId": "$turnId",
        "item": {
          "id": "wake-answer",
          "type": "agentMessage",
          "text": "Wake turn result."
        }
      }
    },
    {
      "method": "turn/completed",
      "params": {
        "threadId": "$threadId",
        "turn": { "id": "$turnId", "status": "completed" }
      }
    }
  ],
  "expectedStatus": "completed",
  "assert": {
    "eventKinds": ["user"],
    "usage": ["inputTokens", "16"],
    "turnStarts": 2
  }
}
