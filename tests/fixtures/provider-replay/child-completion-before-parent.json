{
  "source": "hand-authored protocol frames based on tests/runtime-contract.py FakeServer.complete",
  "parentChildOrder": true,
  "events": [],
  "childEvents": [
    {
      "method": "item/completed",
      "params": {
        "threadId": "$threadId",
        "turnId": "$turnId",
        "item": {
          "id": "child-answer",
          "type": "agentMessage",
          "text": "Child completed first."
        }
      }
    },
    {
      "method": "turn/completed",
      "params": {
        "threadId": "$threadId",
        "turn": { "id": "$turnId", "status": "completed" }
      }
    }
  ],
  "parentEvents": [
    {
      "method": "item/completed",
      "params": {
        "threadId": "$threadId",
        "turnId": "$turnId",
        "item": {
          "id": "parent-answer",
          "type": "agentMessage",
          "text": "Lead completed after child."
        }
      }
    },
    {
      "method": "turn/completed",
      "params": {
        "threadId": "$threadId",
        "turn": { "id": "$turnId", "status": "completed" }
      }
    }
  ],
  "expectedStatus": "completed",
  "assert": {
    "eventKinds": ["user"],
    "childResultCount": 1,
    "answerItems": [
      {
        "owner": "lead",
        "nativeId": "parent-answer",
        "text": "Lead completed after child."
      },
      {
        "owner": "child",
        "nativeId": "child-answer",
        "text": "Child completed first."
      }
    ]
  }
}
