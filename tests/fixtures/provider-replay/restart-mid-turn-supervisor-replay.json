{
  "source": "hand-authored supervisor event frames based on tests/process-supervisor-contract.py",
  "supervisorReplay": true,
  "events": [
    {
      "method": "item/agentMessage/delta",
      "params": {
        "threadId": "$threadId",
        "turnId": "$turnId",
        "itemId": "resume-answer",
        "delta": "Recovered output."
      }
    },
    {
      "method": "item/completed",
      "params": {
        "threadId": "$threadId",
        "turnId": "$turnId",
        "item": {
          "id": "resume-answer",
          "type": "agentMessage",
          "text": "Recovered output."
        }
      }
    },
    {
      "method": "turn/completed",
      "params": {
        "threadId": "$threadId",
        "turn": { "id": "$turnId", "status": "completed" }
      }
    }
  ],
  "expectedStatus": "completed",
  "assert": { "eventKinds": ["user"] }
}
