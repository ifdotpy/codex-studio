{
  "action": "set",
  "spec": {
    "root": "projects",
    "state": {
      "project": "runtime"
    },
    "elements": {
      "projects": {
        "type": "Tabs",
        "props": {
          "value": {
            "$bindState": "/project"
          },
          "options": [
            {
              "label": "Runtime",
              "value": "runtime"
            },
            {
              "label": "SDK",
              "value": "sdk"
            },
            {
              "label": "Desktop",
              "value": "desktop"
            }
          ]
        },
        "children": [
          "runtime",
          "sdk",
          "desktop"
        ]
      },
      "runtime": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "visible": {
          "$state": "/project",
          "eq": "runtime"
        },
        "children": [
          "runtime-steps",
          "runtime-progress",
          "runtime-footer"
        ]
      },
      "runtime-steps": {
        "type": "Steps",
        "props": {
          "items": [
            {
              "label": "Build",
              "status": "complete"
            },
            {
              "label": "Check",
              "status": "active"
            },
            {
              "label": "Review",
              "status": "pending"
            }
          ]
        }
      },
      "runtime-progress": {
        "type": "Progress",
        "props": {
          "label": "Runtime checks",
          "value": 7,
          "total": 10
        }
      },
      "runtime-footer": {
        "type": "Stack",
        "props": {
          "direction": "row",
          "align": "center",
          "justify": "between",
          "gap": "sm"
        },
        "children": [
          "runtime-status",
          "runtime-details"
        ]
      },
      "runtime-status": {
        "type": "Badge",
        "props": {
          "label": "2 checks failed",
          "tone": "warning"
        }
      },
      "runtime-details": {
        "type": "Button",
        "props": {
          "label": "Details",
          "callback": "details_runtime"
        }
      },
      "sdk": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "visible": {
          "$state": "/project",
          "eq": "sdk"
        },
        "children": [
          "sdk-steps",
          "sdk-progress",
          "sdk-footer"
        ]
      },
      "sdk-steps": {
        "type": "Steps",
        "props": {
          "items": [
            {
              "label": "Compile",
              "status": "complete"
            },
            {
              "label": "Link",
              "status": "active"
            },
            {
              "label": "Verify",
              "status": "pending"
            }
          ]
        }
      },
      "sdk-progress": {
        "type": "Progress",
        "props": {
          "label": "SDK checks",
          "value": 4,
          "total": 5
        }
      },
      "sdk-footer": {
        "type": "Stack",
        "props": {
          "direction": "row",
          "align": "center",
          "justify": "between",
          "gap": "sm"
        },
        "children": [
          "sdk-status",
          "sdk-details"
        ]
      },
      "sdk-status": {
        "type": "Badge",
        "props": {
          "label": "Link in progress",
          "tone": "accent"
        }
      },
      "sdk-details": {
        "type": "Button",
        "props": {
          "label": "Details",
          "callback": "details_sdk"
        }
      },
      "desktop": {
        "type": "Stack",
        "props": {
          "gap": "xs"
        },
        "visible": {
          "$state": "/project",
          "eq": "desktop"
        },
        "children": [
          "desktop-steps",
          "desktop-progress",
          "desktop-footer"
        ]
      },
      "desktop-steps": {
        "type": "Steps",
        "props": {
          "items": [
            {
              "label": "Build",
              "status": "complete"
            },
            {
              "label": "Test",
              "status": "complete"
            },
            {
              "label": "Review",
              "status": "active"
            }
          ]
        }
      },
      "desktop-progress": {
        "type": "Progress",
        "props": {
          "label": "Desktop checks",
          "value": 3,
          "total": 3
        }
      },
      "desktop-footer": {
        "type": "Stack",
        "props": {
          "direction": "row",
          "align": "center",
          "justify": "between",
          "gap": "sm"
        },
        "children": [
          "desktop-status",
          "desktop-details"
        ]
      },
      "desktop-status": {
        "type": "Badge",
        "props": {
          "label": "Awaiting review",
          "tone": "neutral"
        }
      },
      "desktop-details": {
        "type": "Button",
        "props": {
          "label": "Details",
          "callback": "details_desktop"
        }
      }
    }
  },
  "callbacks": [
    {
      "id": "details_runtime",
      "label": "Show runtime evidence",
      "fields": []
    },
    {
      "id": "details_sdk",
      "label": "Show SDK evidence",
      "fields": []
    },
    {
      "id": "details_desktop",
      "label": "Show desktop evidence",
      "fields": []
    }
  ]
}
