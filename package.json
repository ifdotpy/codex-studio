{
  "name": "codex-studio-tooling",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "api:generate": "python3 workspaces/runtime/apps/server/src/codex_python.py --exec -m studio_api.generate_types",
    "api:check": "python3 workspaces/runtime/apps/server/src/codex_python.py --exec -m studio_api.generate_types --check",
    "typecheck:runtime": "python3 workspaces/runtime/apps/server/src/codex_python.py --mypy",
    "test:client": "pnpm run typecheck:client-helper && pnpm --filter codex-agents-web test",
    "typecheck:client-helper": "pnpm --filter codex-agents-web exec tsc --project tests/tsconfig.json",
    "test:client:unit": "pnpm --filter codex-agents-web run test:unit",
    "test:client:browser": "pnpm --filter codex-agents-web run test:browser",
    "test:server": "pnpm run test:server:python && pnpm run test:server:bridge",
    "test:server:python": "python3 -B workspaces/runtime/apps/server/src/test-server.py",
    "test:server:bridge": "pnpm --filter studio-claude-bridge run test",
    "test:server:transport": "node workspaces/runtime/apps/server/tests/claude-commands-contract.mjs",
    "test:server:images": "node workspaces/runtime/apps/server/tests/claude-image-contract.mjs",
    "test:desktop": "pnpm --filter codex-agents-desktop test",
    "test:desktop:native": "pnpm --filter codex-agents-desktop run test:native",
    "test:native:schema": "CODEX_NATIVE_SCHEMA=1 pnpm --filter codex-agents-web run test:unit -- nativeErrors.schema",
    "test:server:list": "python3 -B workspaces/runtime/apps/server/src/test-server.py --list",
    "test:mutation": "pnpm --filter codex-agents-web run test:mutation",
    "lint:all": "oxlint --deny-warnings",
    "format:check:all": "oxfmt --check",
    "test:provider-replay": "python3 -B workspaces/runtime/apps/server/tests/provider-replay-runner.py && python3 -B workspaces/runtime/apps/server/tests/provider-capture-contract.py",
    "lint:staged": "node workspaces/tooling/apps/repository-checks/check-code.mjs staged lint",
    "format:staged": "node workspaces/tooling/apps/repository-checks/check-code.mjs staged format",
    "check:staged": "node workspaces/tooling/apps/repository-checks/check-code.mjs staged",
    "test:pre-commit": "node workspaces/tooling/apps/repository-checks/tests/pre-commit-hook.mjs",
    "check:tooling": "pnpm run test:tooling",
    "test:tooling": "node --test workspaces/tooling/apps/repository-checks/tests/facade.test.mjs"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0"
  },
  "packageManager": "pnpm@12.10.1",
  "codexStudioChecks": {
    "test": "test:tooling",
    "check": [
      "check:tooling"
    ]
  }
}
