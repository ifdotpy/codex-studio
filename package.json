{
  "name": "codex-studio-tooling",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "contracts:generate": "cargo run --quiet --locked -p studio-runtime-schema --bin studio-contracts -- --write",
    "contracts:check": "cargo run --quiet --locked -p studio-runtime-schema --bin studio-contracts -- --check",
    "test:client": "pnpm run typecheck:client-helper && pnpm --filter codex-agents-web test",
    "typecheck:client-helper": "pnpm --filter codex-agents-web exec tsc --project tests/tsconfig.json --incremental --tsBuildInfoFile \"${STUDIO_TSC_CACHE:-${TMPDIR:-/tmp}}/codex-studio-client-helper.tsbuildinfo\"",
    "test:client:unit": "pnpm --filter codex-agents-web run test:unit",
    "test:client:browser": "pnpm --filter codex-agents-web run test:browser",
    "test:server:bridge": "pnpm --filter studio-claude-bridge run test",
    "test:desktop": "pnpm --filter codex-agents-desktop test",
    "test:desktop:native": "pnpm --filter codex-agents-desktop run test:native",
    "test:native:schema": "CODEX_NATIVE_SCHEMA=1 pnpm --filter codex-agents-web run test:unit -- nativeErrors.schema",
    "test:mutation": "pnpm --filter codex-agents-web run test:mutation",
    "lint:all": "oxlint --deny-warnings",
    "format:check:all": "oxfmt --check",
    "lint:staged": "node workspaces/tooling/apps/repository-checks/check-code.mjs staged lint",
    "format:staged": "node workspaces/tooling/apps/repository-checks/check-code.mjs staged format",
    "check:staged": "node workspaces/tooling/apps/repository-checks/check-code.mjs staged",
    "test:pre-commit": "node workspaces/tooling/apps/repository-checks/tests/pre-commit-hook.mjs",
    "check:tooling": "pnpm run test:tooling",
    "test:tooling": "node --test workspaces/tooling/apps/repository-checks/tests/web-precompression.test.mjs workspaces/tooling/apps/repository-checks/tests/gates.test.mjs workspaces/tooling/apps/repository-checks/tests/facade.test.mjs workspaces/tooling/apps/repository-checks/tests/release-binaries.test.mjs workspaces/tooling/apps/repository-checks/tests/scale-verifier-teardown.test.mjs workspaces/tooling/apps/repository-checks/tests/native-style-policy.test.mjs workspaces/tooling/apps/installed-smoke/tests/smoke.test.mjs"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@12.15.0",
  "codexStudioChecks": {
    "test": "test:tooling",
    "check": [
      "check:tooling"
    ]
  }
}
