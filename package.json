{
  "name": "codex-studio-tooling",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "api:generate": "python3 scripts/codex_python.py --exec -m studio_api.generate_types",
    "api:check": "python3 scripts/codex_python.py --exec -m studio_api.generate_types --check",
    "test:client": "npm run typecheck:client-helper && npm --prefix web test",
    "typecheck:client-helper": "node web/node_modules/typescript/bin/tsc --project tests/client/tsconfig.json",
    "test:client:unit": "npm --prefix web run test:unit",
    "test:client:browser": "npm --prefix web run test:browser",
    "test:server": "npm run test:server:python && npm run test:server:bridge",
    "test:server:python": "python3 -B scripts/test-server.py",
    "test:server:bridge": "node web/node_modules/vitest/vitest.mjs run --config scripts/claude_bridge/vitest.config.mjs",
    "test:server:transport": "node tests/claude-commands-contract.mjs",
    "test:server:images": "node tests/claude-image-contract.mjs",
    "test:desktop": "npm --prefix desktop test",
    "test:desktop:native": "npm --prefix desktop run test:native",
    "test:native:schema": "CODEX_NATIVE_SCHEMA=1 npm --prefix web run test:unit -- nativeErrors.schema",
    "test:server:list": "python3 -B scripts/test-server.py --list",
    "test:mutation": "npm --prefix web run test:mutation",
    "lint:all": "oxlint --deny-warnings",
    "format:check:all": "oxfmt --check",
    "test:provider-replay": "python3 -B tests/provider-replay-runner.py && python3 -B tests/provider-capture-contract.py",
    "lint:staged": "node scripts/check-code.mjs staged lint",
    "format:staged": "node scripts/check-code.mjs staged format",
    "check:staged": "node scripts/check-code.mjs staged",
    "test:pre-commit": "node tests/pre-commit-hook.mjs"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0"
  }
}
