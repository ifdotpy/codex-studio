{
  "name": "codex-agents-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Native desktop host for the Codex Studio workspace",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "npm --prefix ../web run build && electron .",
    "start:hidden": "electron . --hidden",
    "package": "node package.mjs",
