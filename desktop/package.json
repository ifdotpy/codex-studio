{
  "name": "codex-agents-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Native desktop host for the Codex Studio workspace",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "npm --prefix ../web run build && electron .",
    "start:hidden": "electron . --hidden",
    "package": "node package.mjs",
    "package:ui": "node package.mjs --ui-only",
    "start:ui": "electron . --ui-only",
    "test": "node ../web/node_modules/vitest/vitest.mjs run --config vitest.config.mjs && python3 -B recovery-test.py",
    "test:native": "node test.mjs",
    "test:server-frames": "node server-frames-native.mjs",
    "test:package": "node package-test.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.2.0",
    "playwright-core": "1.63.0"
  }
}
